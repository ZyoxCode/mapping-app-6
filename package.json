{
    "name": "mapping-app-6",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "build:islands": "tsx scripts/process-islands.ts data-raw/islands.geojson public/data/island-labels.json",
