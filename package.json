        "typescript": "~6.0.2",
        "vite": "^8.3.0"
    },
    "dependencies": {
        "@mapbox/vector-tile": "^3.0.0",
        "mapbox": "^1.0.0-beta10",
        "pbf": "^5.1.2",
        "pmtiles": "^4.5.0",
        "polylabel": "^2.1.0",
        "shpjs": "^6.2.0"
    }
